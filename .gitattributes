
# ==============================
# Text files - use LF
# ==============================

* text=auto

*.cs text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.glsl text eol=lf

*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.asmdef text eol=lf
*.rsp text eol=lf

# Unity YAML files
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.meta text eol=lf

# ==============================
# Binary files
# ==============================

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.bmp binary
*.webp binary

*.fbx binary
*.obj binary
*.blend binary

*.wav binary
*.mp3 binary
*.ogg binary
*.aiff binary

*.mp4 binary
*.mov binary
*.avi binary

*.ttf binary
*.otf binary
*.dll binary
*.exe binary
*.zip binary
*.7z binary
*.pdf binary
